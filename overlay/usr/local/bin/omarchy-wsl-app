#!/bin/bash
# omarchy-wsl-app - run a single graphical app through WSLg with the right
# Wayland/X11/audio environment already exported.
#
#   omarchy-wsl-app chromium
#   omarchy-wsl-app foot
#   omarchy-wsl-app nautilus ~/Projects

set -euo pipefail
source /usr/local/bin/omarchy-wsl-env

if [[ $# -eq 0 ]]; then
  echo "usage: omarchy-wsl-app <command> [args...]" >&2
  exit 1
fi

owsl_export_wslg_env

if [[ -z ${WAYLAND_DISPLAY:-} && -z ${DISPLAY:-} ]]; then
  echo "No WSLg display available. Run omarchy-wsl-doctor to diagnose." >&2
  exit 1
fi

# Chromium and Electron apps encrypt their cookie/password store with the
# system keyring. When the keyring is locked they raise an "Unlock Login
# Keyring" dialog on every launch - and under WSL there is often no unlocked
# keyring, because there is no PAM login to unlock it.
#
# If we could not unlock one, tell them to use their own basic store instead,
# so the app starts rather than blocking on a dialog. When the keyring IS
# available we say nothing and they use it as normal.
case "${1##*/}" in
  chromium|chrome|google-chrome*|brave*|code|codium|electron*|signal-desktop|slack|discord)
    if [[ -z ${GNOME_KEYRING_CONTROL:-} ]]; then
      set -- "$1" --password-store=basic "${@:2}"
    fi
    ;;
esac

exec "$@"
