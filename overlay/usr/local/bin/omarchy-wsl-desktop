#!/bin/bash
# omarchy-wsl-desktop - start a full Wayland desktop session under WSL2.
#
# WHY THIS RUNS SWAY AND NOT HYPRLAND
# -----------------------------------
# WSL2 exposes no DRM device at all - only /dev/dxg, rendered through
# Direct3D12 via libdxcore. There is no /dev/dri/cardN and no render node.
#
# Hyprland >= 0.45 uses Aquamarine, which unconditionally builds a GBM
# allocator from a DRM node and fails the whole backend without one
# ("Cannot open backend: no allocator available"). Its headless backend
# reports drmFD() == -1, so headless cannot satisfy it either, and WSLg does
# not advertise zwp_linux_dmabuf_v1, so the nested Wayland backend bails out
# with "Missing protocols".
#
# wlroots - which sway uses - falls back to a *shm* allocator when neither the
# backend nor the renderer requires DMABUF, and that path needs no DRM node
# whatsoever. With WLR_RENDERER=pixman we get a fully software desktop that
# runs anywhere.
#
# The full analysis, including the vkms experiment, is in
# docs/12-wayland-on-wsl2.md.
#
# Usage:
#   omarchy-wsl-desktop [nested|vnc] [options]
#
# Modes:
#   nested  (default)  the desktop is one resizable window on your Windows
#                      desktop, running as a Wayland client of WSLg.
#   vnc                the desktop runs on a virtual output served over VNC.
#                      Connect a Windows VNC client for a true full screen.
#
# Options:
#   --size WxH        output size; in nested mode this sets the window size
#   --port N          VNC port                          (default 5900)
#   --bind ADDR       VNC bind address                  (default 127.0.0.1)
#   --floating        windows float with titlebars, like Windows/GNOME
#   --tiling          windows tile automatically (the Omarchy default)
#   --compositor C    sway (default) or hyprland (known-broken, see above)
#   --software        accepted for compatibility; already the default
#   -h, --help        this message

set -euo pipefail
source /usr/local/bin/omarchy-wsl-env

MODE="nested"
SIZE="1920x1080"
PORT="5900"
BIND="127.0.0.1"
COMPOSITOR="sway"

usage() { sed -n '24,42p' "$0" | sed 's/^# \?//'; exit "${1:-0}"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    nested|vnc)   MODE="$1"; shift ;;
    --size)       SIZE="${2:?--size needs WxH}"; SIZE_SET=1; shift 2 ;;
    --port)       PORT="${2:?--port needs a number}"; shift 2 ;;
    --bind)       BIND="${2:?--bind needs an address}"; shift 2 ;;
    --floating)   LAYOUT=floating; shift ;;
    --tiling)     LAYOUT=tiling; shift ;;
    --compositor) COMPOSITOR="${2:?--compositor needs sway or hyprland}"; shift 2 ;;
    --software)   shift ;;
    -h|--help)    usage 0 ;;
    *) echo "unknown option: $1" >&2; usage 1 ;;
  esac
done

[[ $SIZE =~ ^[0-9]+x[0-9]+$ ]] || { echo "--size must look like 1920x1080" >&2; exit 1; }
[[ $PORT =~ ^[0-9]+$ ]]        || { echo "--port must be a number" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Layout preference is persisted into ~/.config/sway/local.conf, which the
# session config includes last, so it wins over the defaults. Tiling is
# Omarchy's model; floating is the familiar Windows/GNOME behaviour and is
# there so people can get productive before learning the keybindings.
# ---------------------------------------------------------------------------
LOCAL_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/sway/local.conf"
MARK_BEGIN="# >>> omarchy-wsl2 layout >>>"
MARK_END="# <<< omarchy-wsl2 layout <<<"

apply_layout() {
  local want="$1"
  [[ -z $want ]] && return 0
  mkdir -p "$(dirname "$LOCAL_CONF")"
  touch "$LOCAL_CONF"

  # Drop any previous block, then re-add if needed.
  if grep -qF "$MARK_BEGIN" "$LOCAL_CONF" 2>/dev/null; then
    sed -i "/^${MARK_BEGIN}$/,/^${MARK_END}$/d" "$LOCAL_CONF"
  fi

  if [[ $want == floating ]]; then
    cat >>"$LOCAL_CONF" <<EOF
$MARK_BEGIN
# Windows float with titlebars, like Windows or GNOME.
# Switch back with: omarchy-wsl-desktop --tiling
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
default_border normal 2
$MARK_END
EOF
    echo "Layout: floating (draggable windows with titlebars)"
  else
    echo "Layout: tiling (Omarchy default)"
  fi
}

apply_layout "${LAYOUT:-}"

owsl_export_wslg_env

# ---------------------------------------------------------------------------
# A private XDG_RUNTIME_DIR is required: the compositor creates its own
# Wayland and IPC sockets in there.
# ---------------------------------------------------------------------------
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway

# wlroots software path. WSL2 has no DRM node, so the GLES2/Vulkan renderers
# have nothing to bind to; pixman renders on the CPU into shm buffers.
export WLR_RENDERER=pixman
export WLR_NO_HARDWARE_CURSORS=1
# There are no real input devices behind the compositor - all input arrives
# from WSLg or from wayvnc's virtual keyboard/pointer.
export WLR_LIBINPUT_NO_DEVICES=1

# ---------------------------------------------------------------------------
# Hyprland is retained behind an explicit flag so that if Aquamarine ever
# grows an shm path this starts working again - but tell the truth about it.
# ---------------------------------------------------------------------------
if [[ $COMPOSITOR == hyprland ]]; then
  cat >&2 <<'MSG'
WARNING: Hyprland cannot currently run under WSL2.

Aquamarine (Hyprland's backend) requires a GBM allocator built from a DRM
node. WSL2 provides none, and WSLg does not advertise zwp_linux_dmabuf_v1,
so every backend it offers fails:

    wayland   ->  "Wayland backend cannot start: Missing protocols"
    drm       ->  no /dev/dri device to attach to
    headless  ->  drmFD() == -1, "no allocator available"

Attempting anyway. See docs/12-wayland-on-wsl2.md, and use the default
(sway) compositor for a desktop that actually works.

MSG
  HYPR=$(command -v Hyprland || command -v hyprland) \
    || { echo "Hyprland is not installed." >&2; exit 1; }
  # Best-known-configuration, for whenever upstream makes this viable.
  export AQ_NO_MODIFIERS=1 GBM_ALWAYS_SOFTWARE=1 LIBGL_ALWAYS_SOFTWARE=1
  exec "$HYPR"
fi

command -v sway >/dev/null 2>&1 \
  || { echo "sway is not installed. Rebuild with PROFILE=desktop." >&2; exit 1; }

case "$MODE" in
  # -------------------------------------------------------------- nested ---
  nested)
    if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
      echo "No WSLg Wayland socket found - cannot nest. Try: omarchy-wsl-desktop vnc" >&2
      exit 1
    fi

    export WLR_BACKENDS=wayland
    export WLR_WL_OUTPUTS=1

    echo "Starting the desktop nested in WSLg (host socket: $WAYLAND_DISPLAY)..."
    echo "Close the window, or press SUPER+SHIFT+E, to exit."

    # The host window carries no titlebar: sway requests client-side
    # decorations and draws none, and WSLg does not add its own. Its size is
    # simply the size of the wlroots Wayland-backend output, so --size is the
    # way to control it. Without --size we just hand over to sway directly.
    if [[ -z ${SIZE_SET:-} ]]; then
      exec sway
    fi

    sway &
    SWAY_PID=$!
    trap 'kill "$SWAY_PID" 2>/dev/null || true' EXIT INT TERM

    SWAYSOCK="$XDG_RUNTIME_DIR/sway-ipc.$(id -u).$SWAY_PID.sock"
    for _ in $(seq 1 60); do
      [[ -S $SWAYSOCK ]] && break
      kill -0 "$SWAY_PID" 2>/dev/null || break
      sleep 0.25
    done

    if [[ -S $SWAYSOCK ]]; then
      OUTPUT=$(swaymsg -s "$SWAYSOCK" -t get_outputs -r \
               | sed -n 's/.*"name": *"\([^"]*\)".*/\1/p' | head -1)
      swaymsg -s "$SWAYSOCK" output "${OUTPUT:-WL-1}" resolution "$SIZE" \
        >/dev/null 2>&1 || true
      echo "Window sized to ${SIZE}. Resize later from inside the session with:"
      echo "    swaymsg output ${OUTPUT:-WL-1} resolution 1600x900"
    fi

    wait "$SWAY_PID"
    ;;

  # ----------------------------------------------------------------- vnc ---
  vnc)
    command -v wayvnc >/dev/null 2>&1 \
      || { echo "wayvnc is not installed. Rebuild with PROFILE=desktop." >&2; exit 1; }

    export WLR_BACKENDS=headless
    export WLR_HEADLESS_OUTPUTS=1
    # Detach from WSLg, or wlroots picks the Wayland backend instead.
    unset WAYLAND_DISPLAY

    echo "Starting the desktop on a virtual ${SIZE} output..."
    sway &
    SWAY_PID=$!
    trap 'kill "$SWAY_PID" 2>/dev/null || true' EXIT INT TERM

    # sway names its IPC socket deterministically from uid + pid.
    SWAYSOCK="$XDG_RUNTIME_DIR/sway-ipc.$(id -u).$SWAY_PID.sock"

    for _ in $(seq 1 60); do
      [[ -S $SWAYSOCK ]] && break
      kill -0 "$SWAY_PID" 2>/dev/null || break
      sleep 0.25
    done

    if [[ ! -S $SWAYSOCK ]]; then
      echo "The compositor did not start." >&2
      echo "Run 'omarchy-wsl-doctor' and see docs/09-troubleshooting.md." >&2
      exit 1
    fi

    OUTPUT=$(swaymsg -s "$SWAYSOCK" -t get_outputs -r \
             | sed -n 's/.*"name": *"\([^"]*\)".*/\1/p' | head -1)
    OUTPUT="${OUTPUT:-HEADLESS-1}"
    swaymsg -s "$SWAYSOCK" output "$OUTPUT" mode "${SIZE}@60Hz" >/dev/null 2>&1 || true

    # wayvnc must talk to sway's socket, not WSLg's.
    WAYLAND_SOCK=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-*' -type s 2>/dev/null \
                   | head -1)
    if [[ -n ${WAYLAND_SOCK:-} ]]; then
      WAYLAND_DISPLAY="$(basename "$WAYLAND_SOCK")"
      export WAYLAND_DISPLAY
    fi

    echo
    echo "  Connect a VNC client on Windows to:  ${BIND}:${PORT}"
    echo "  Output: ${OUTPUT} @ ${SIZE}"
    echo "  Press Ctrl-C to shut the desktop down."
    echo
    exec wayvnc -o "$OUTPUT" "$BIND" "$PORT"
    ;;
esac
