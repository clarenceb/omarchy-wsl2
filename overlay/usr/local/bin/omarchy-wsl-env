#!/bin/bash
# omarchy-wsl-env - shared environment detection for the omarchy-wsl2 helpers.
# Source this; don't execute it.
#
#   source /usr/local/lib/omarchy-wsl2/omarchy-wsl-env

owsl_is_wsl() {
  [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]] || grep -qi microsoft /proc/version
}

# WSLg publishes its Wayland socket under /mnt/wslg, which is usually NOT the
# same directory as XDG_RUNTIME_DIR when systemd is enabled (/run/user/UID).
# Find the socket wherever it actually lives.
owsl_find_wayland_socket() {
  local d s
  for d in "${XDG_RUNTIME_DIR:-}" /mnt/wslg/runtime-dir "/run/user/$(id -u)"; do
    [[ -z $d ]] && continue
    for s in "${WAYLAND_DISPLAY:-wayland-0}" wayland-0 wayland-1; do
      if [[ -S "$d/$s" ]]; then
        printf '%s\n%s\n' "$d" "$s"
        return 0
      fi
    done
  done
  return 1
}

# Make the WSLg socket reachable from the systemd-managed XDG_RUNTIME_DIR by
# symlinking it in. Wayland clients only look inside XDG_RUNTIME_DIR.
owsl_link_wayland_socket() {
  local found dir sock rt
  found=$(owsl_find_wayland_socket) || return 1
  dir=$(sed -n 1p <<<"$found")
  sock=$(sed -n 2p <<<"$found")

  rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  mkdir -p "$rt" 2>/dev/null || true

  if [[ "$dir" != "$rt" && ! -e "$rt/$sock" ]]; then
    ln -sf "$dir/$sock" "$rt/$sock" 2>/dev/null || true
    # Some toolkits also want the lock file.
    [[ -e "$dir/$sock.lock" ]] && ln -sf "$dir/$sock.lock" "$rt/$sock.lock" 2>/dev/null
  fi

  export XDG_RUNTIME_DIR="$rt"
  export WAYLAND_DISPLAY="$sock"
  return 0
}

# A session dbus is needed for notifications, portals, the keyring and GTK/Qt
# internals. Normally systemd's user manager provides it at
# $XDG_RUNTIME_DIR/bus - but that manager frequently fails under WSL (Docker
# Desktop's integration leaves PID 0 ghosts in the cgroup tree, so
# clone3(CLONE_INTO_CGROUP) returns EBUSY). Fall back to a plain session bus so
# GUI apps work either way.
owsl_ensure_dbus() {
  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && return 0

  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  mkdir -p "$rt" 2>/dev/null || true
  chmod 700 "$rt" 2>/dev/null || true

  if [[ -S "$rt/bus" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus"
    return 0
  fi

  command -v dbus-daemon >/dev/null 2>&1 || return 1

  # --fork daemonises; another shell may win the race, so re-check after.
  dbus-daemon --session --address="unix:path=$rt/bus" \
              --fork --nopidfile --syslog-only >/dev/null 2>&1 || true

  if [[ -S "$rt/bus" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus"
    return 0
  fi
  return 1
}

# A Secret Service provider is needed by anything that stores credentials:
# GitHub Copilot CLI, gh, git-credential-libsecret, VS Code. Without one they
# fall back to plaintext files, or prompt:
#
#     System keychain unavailable. Store token in plaintext config file? (y/N)
#
# On a desktop this is started by the display manager and unlocked by PAM at
# login. WSL has neither, so start it here.
#
# The keyring is unlocked with an empty password, which makes it usable
# without an interactive prompt on every session. That is a deliberate
# trade-off for WSL: the keyring file lives inside your distro's VHDX, which
# is already readable by anything running as you. It is meaningfully better
# than plaintext config (secrets are not sitting in a dotfile that gets
# rsynced, committed or copied to /mnt/c by accident) but it is NOT protection
# against someone with access to your Windows account. Set a real password
# with `omarchy-wsl-keyring --password` if you want that.
owsl_ensure_keyring() {
  command -v gnome-keyring-daemon >/dev/null 2>&1 || return 1
  [[ -n ${GNOME_KEYRING_CONTROL:-} ]] && return 0

  owsl_ensure_dbus || return 1

  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [[ -S "$rt/keyring/control" ]]; then
    export GNOME_KEYRING_CONTROL="$rt/keyring"
    [[ -S "$rt/keyring/ssh" && -z ${SSH_AUTH_SOCK:-} ]] \
      && export SSH_AUTH_SOCK="$rt/keyring/ssh"
    return 0
  fi

  local out
  # --unlock reads the password from stdin; an empty line unlocks a keyring
  # created with an empty password, and is ignored otherwise.
  out=$(printf '\n' | gnome-keyring-daemon --start --components=secrets,ssh \
        2>/dev/null) || return 1

  # The daemon prints VAR=value lines for us to adopt.
  local line
  while IFS= read -r line; do
    case "$line" in
      GNOME_KEYRING_CONTROL=*|SSH_AUTH_SOCK=*)
        export "${line?}" ;;
    esac
  done <<<"$out"

  [[ -n ${GNOME_KEYRING_CONTROL:-} ]]
}

# Standard WSLg client environment: Wayland + X11 + audio.
owsl_export_wslg_env() {
  owsl_link_wayland_socket || true

  [[ -z ${DISPLAY:-} ]] && export DISPLAY=:0
  [[ -S /mnt/wslg/PulseServer ]] && export PULSE_SERVER=/mnt/wslg/PulseServer

  owsl_ensure_dbus || true
  owsl_ensure_keyring || true

  export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
  export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
  export MOZ_ENABLE_WAYLAND=1
  export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
  export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
  export _JAVA_AWT_WM_NONREPARENTING=1

  # WSLg's virtual GPU is Direct3D12-backed via /dev/dxg, exposed to Mesa as
  # the d3d12 Gallium driver. Only opt in when the device is really there.
  if [[ -e /dev/dxg ]]; then
    export GALLIUM_DRIVER="${GALLIUM_DRIVER:-d3d12}"
    export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-d3d12}"
  else
    export LIBGL_ALWAYS_SOFTWARE=1
  fi
}
