#!/bin/bash
# omarchy-wsl-keyring - set up the Secret Service keyring under WSL2.
#
# WHY THIS EXISTS
# ---------------
# Tools that store credentials - GitHub Copilot CLI, gh, git's libsecret
# helper, VS Code - look for a Secret Service provider on D-Bus. On a normal
# desktop that is gnome-keyring, started by the display manager and unlocked
# by PAM when you log in. WSL has no display manager and no PAM login, so
# nothing starts it and you get:
#
#     System keychain unavailable. Store token in plaintext config file? (y/N)
#
# This creates the login keyring, starts the daemon, and verifies it works.
#
# Usage:
#   omarchy-wsl-keyring              set up with an empty password (default)
#   omarchy-wsl-keyring --password   set up with a password you type each session
#   omarchy-wsl-keyring --status     report what is running
#   omarchy-wsl-keyring --test       store and read back a test secret
#   omarchy-wsl-keyring --unlock     unlock the existing keyring in this session
#   omarchy-wsl-keyring --reset      back up existing keyrings and start over

set -euo pipefail
source /usr/local/bin/omarchy-wsl-env

B=$'\033[1m'; R=$'\033[0m'
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✖\033[0m %s\n' "$*"; }
note() { printf '    %s\n' "$*"; }

KEYRING_DIR="$HOME/.local/share/keyrings"

need() {
  command -v "$1" >/dev/null 2>&1 || {
    bad "$1 is not installed"
    note "sudo pacman -Syu --needed gnome-keyring libsecret"
    exit 1
  }
}

status() {
  printf '\n%sKeyring status%s\n\n' "$B" "$R"
  command -v gnome-keyring-daemon >/dev/null 2>&1 \
    && ok "gnome-keyring-daemon installed" || bad "gnome-keyring-daemon missing"
  command -v secret-tool >/dev/null 2>&1 \
    && ok "secret-tool installed (libsecret)" || bad "secret-tool missing"

  [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] \
    && ok "session D-Bus: ${DBUS_SESSION_BUS_ADDRESS}" \
    || bad "no session D-Bus - credentials cannot work without it"

  if [[ -n ${GNOME_KEYRING_CONTROL:-} ]]; then
    ok "keyring daemon: $GNOME_KEYRING_CONTROL"
  else
    bad "keyring daemon not running in this shell"
  fi

  if compgen -G "$KEYRING_DIR/*.keyring" >/dev/null; then
    ok "keyrings present: $(basename -a "$KEYRING_DIR"/*.keyring | tr '\n' ' ')"
  else
    bad "no keyring has been created yet"
  fi
  printf '\n'
}

# Every secret-tool call is wrapped in a timeout. If the collection is locked,
# the Secret Service raises a Prompt object and waits for an agent to answer
# it; there is no agent here, so the call would block forever.
st() { timeout 10 secret-tool "$@"; }

test_secret() {
  need secret-tool
  local rc=0
  st store --label='omarchy-wsl2 test' service omarchy-wsl2 key test \
     <<<'hello' >/dev/null 2>&1 || rc=$?

  if (( rc == 124 )); then
    bad "secret-tool timed out - the keyring is locked and nothing can unlock it"
    note "The login keyring exists but has a password this tool does not know."
    note "Either unlock it in this session, or start over:"
    note "    mv ~/.local/share/keyrings ~/.local/share/keyrings.bak"
    note "    omarchy-wsl-keyring"
    return 1
  fi
  if (( rc != 0 )); then
    bad "could not store a secret (secret-tool exited $rc)"
    return 1
  fi

  local got
  got=$(st lookup service omarchy-wsl2 key test 2>/dev/null || true)
  st clear service omarchy-wsl2 key test >/dev/null 2>&1 || true

  if [[ $got == hello ]]; then
    ok "stored and read back a test secret - the keychain works"
    return 0
  fi
  bad "stored a secret but could not read it back"
  return 1
}

setup() {
  local use_password="${1:-0}"
  need gnome-keyring-daemon

  owsl_ensure_dbus || { bad "could not start a session D-Bus"; exit 1; }
  mkdir -p "$KEYRING_DIR"

  # An existing keyring has its own password, which this tool cannot know. The
  # daemon will raise an "Unlock Login Keyring" dialog that neither an empty
  # password nor the user's Linux password will satisfy, because the two are
  # unrelated - there is no PAM integration under WSL to keep them in step.
  if (( ! use_password )) && [[ -f $KEYRING_DIR/login.keyring ]]; then
    note "An existing login keyring was found."
    note "If you are prompted to unlock it:"
    note "  - leave the password BLANK if this tool created it"
    note "  - your Linux/user password will NOT work; it was never set on it"
    note "  - if neither works, run: omarchy-wsl-keyring --reset"
    printf '\n'
  fi

  local pw=""
  if (( use_password )); then
    printf 'Password for the login keyring (you will type this once per session): '
    read -rs pw; echo
    [[ -z $pw ]] && { bad "empty password - use the default mode instead"; exit 1; }
  fi

  # Kill any half-started daemon so --unlock definitely creates the keyring.
  pkill -x gnome-keyring-daemon 2>/dev/null || true
  sleep 0.3

  # Name 'login' as the default collection. Without this file the daemon has
  # no default keyring, and secret-tool's first store() triggers a "create
  # keyring" Prompt that no agent can answer - which looks like a hang.
  [[ -f $KEYRING_DIR/default ]] || printf 'login\n' >"$KEYRING_DIR/default"

  # --unlock reads the password from stdin and creates the login keyring if it
  # does not exist yet. It must come before --start.
  local out
  out=$(printf '%s\n' "$pw" | timeout 15 gnome-keyring-daemon --unlock 2>/dev/null) || true
  out+=$'\n'
  out+=$(printf '%s\n' "$pw" \
         | timeout 15 gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null) || true

  local line
  while IFS= read -r line; do
    case "$line" in
      GNOME_KEYRING_CONTROL=*|SSH_AUTH_SOCK=*) export "${line?}" ;;
    esac
  done <<<"$out"

  if [[ -z ${GNOME_KEYRING_CONTROL:-} ]]; then
    bad "the daemon did not start"
    note "Try: omarchy-wsl-keyring --status"
    exit 1
  fi

  ok "keyring daemon started"

  if ! test_secret; then
    printf '\n'
    note "Run 'omarchy-wsl-keyring --status' for detail."
    exit 1
  fi

  printf '\n%sDone.%s New shells pick this up automatically.\n' "$B" "$R"
  if (( use_password )); then
    note "You will be asked to unlock once per session."
  else
    note "The keyring has an EMPTY password: if anything ever asks you to"
    note "unlock it, leave the field blank and press Enter."
    note "It lives in $KEYRING_DIR, inside this distro's VHDX."
    note "Better than plaintext config, but not protection against someone"
    note "who already has your Windows account. Use --password for that."
  fi
  printf '\n'
  note "Now re-run the tool that prompted you, e.g.:  copilot  /login"
  printf '\n'
}

# Unlock an already-created keyring. Needed because WSL has no PAM login to do
# it at session start, so a fresh shell finds the collection locked even though
# the daemon is running.
unlock_keyring() {
  need gnome-keyring-daemon
  owsl_ensure_dbus || { bad "no session D-Bus"; exit 1; }

  local pw=""
  if [[ ${1:-} == --ask ]]; then
    printf 'Keyring password (blank if this tool created it): '
    read -rs pw; echo
  fi

  local out
  out=$(printf '%s\n' "$pw" | timeout 10 gnome-keyring-daemon --unlock \
        --components=secrets,ssh 2>/dev/null) || true
  local line
  while IFS= read -r line; do
    case "$line" in
      GNOME_KEYRING_CONTROL=*|SSH_AUTH_SOCK=*) export "${line?}" ;;
    esac
  done <<<"$out"

  if test_secret; then
    printf '\n'
    note "Unlocked. Note this only affects processes started from this shell;"
    note "the desktop session unlocks its own copy when it starts."
    return 0
  fi

  bad "could not unlock with that password"
  note "If you do not know it:  omarchy-wsl-keyring --reset"
  exit 1
}

reset_keyring() {
  local backup="$KEYRING_DIR.bak.$(date +%Y%m%d%H%M%S)"
  # The daemon caches the collection, so it must go before the files move -
  # otherwise the old, locked keyring is still what answers on D-Bus.
  pkill -x gnome-keyring-daemon 2>/dev/null || true
  pkill -f 'gnome-keyring-daemon' 2>/dev/null || true
  sleep 0.5
  unset GNOME_KEYRING_CONTROL
  if [[ -d $KEYRING_DIR ]]; then
    mv "$KEYRING_DIR" "$backup"
    ok "existing keyrings moved to $backup"
  else
    note "no existing keyrings"
  fi
  note "any secrets stored previously are in that backup, not lost"
  printf '\n'
  setup 0
}

case "${1:-}" in
  ""|--setup)   setup 0 ;;
  --password)   setup 1 ;;
  --unlock)     unlock_keyring ;;
  --unlock-ask) unlock_keyring --ask ;;
  --reset)      reset_keyring ;;
  --status)     status ;;
  --test)       status; test_secret ;;
  -h|--help)    sed -n '16,23p' "$0" | sed 's/^# \?//' ;;
  *) echo "unknown option: $1" >&2; exit 1 ;;
esac
