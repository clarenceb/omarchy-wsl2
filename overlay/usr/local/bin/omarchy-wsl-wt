#!/usr/bin/env python3
"""omarchy-wsl-wt - configure the Windows Terminal profile for Omarchy.

WSL auto-creates a Terminal profile from /usr/lib/wsl/terminal-profile.json when
the distro is installed, but it is minimal. This tool makes that profile look
like Omarchy: matching colour scheme, Nerd Font, transparency, padding and the
project icon.

Useful in every mode - headless, WSLg apps and the full desktop - because
Windows Terminal is how you launch all of them.

    omarchy-wsl-wt --detect
    omarchy-wsl-wt --theme "Tokyo Night" --opacity 90
    omarchy-wsl-wt --set-default
    omarchy-wsl-wt --restore

Run it from inside the Omarchy distro, or from any WSL2 distro with the repo
checked out.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

# --------------------------------------------------------------------- ui ---
def _color_ok() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _color_ok() else s

def ok(m):   print("  " + _c("32", "✔") + f" {m}")
def bad(m):  print("  " + _c("31", "✘") + f" {m}", file=sys.stderr)
def warn(m): print("  " + _c("33", "!") + f" {m}")
def note(m): print("  " + _c("90", m))
def head(m): print("\n" + _c("1;36", m))


# ---------------------------------------------------------------- schemes ---
# Windows Terminal colour schemes matched to Omarchy's bundled themes.
