DEFAULT_THEME = "tokyo-night"


def slug(name: str) -> str:
    return name.strip().lower().replace(" ", "-")


# ------------------------------------------------------------- discovery ---
def windows_env(var: str) -> str | None:
    try:
        out = subprocess.run(["cmd.exe", "/c", f"echo %{var}%"],
                             capture_output=True, text=True, timeout=20,
                             cwd="/mnt/c")
        v = out.stdout.strip().replace("\r", "")
        return v if v and not v.startswith("%") else None
    except Exception:
        return None


def to_wsl_path(win: str) -> Path | None:
    try:
        out = subprocess.run(["wslpath", "-u", win], capture_output=True,
                             text=True, timeout=15)
        p = out.stdout.strip()
        return Path(p) if p else None
    except Exception:
        return None


def find_settings() -> Path | None:
    """Locate Windows Terminal settings.json across its install flavours."""
    local = windows_env("LOCALAPPDATA")
    roots: list[Path] = []
    if local:
        lp = to_wsl_path(local)
        if lp:
            roots += [
                lp / "Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json",
                lp / "Packages/Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe/LocalState/settings.json",
                lp / "Microsoft/Windows Terminal/settings.json",
            ]
    # Fall back to scanning /mnt/c/Users when cmd.exe interop is unavailable.
    for user in Path("/mnt/c/Users").glob("*"):
        base = user / "AppData/Local"
        roots += [
            base / "Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json",
            base / "Packages/Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe/LocalState/settings.json",
            base / "Microsoft/Windows Terminal/settings.json",
        ]
    for r in roots:
        try:
            if r.is_file():
                return r
        except OSError:
            continue
    return None


def load_settings(path: Path) -> dict:
    raw = path.read_text(encoding="utf-8-sig")
    # Windows Terminal permits // and /* */ comments in settings.json.
    raw = re.sub(r"/\*.*?\*/", "", raw, flags=re.S)
    raw = re.sub(r"^\s*//.*$", "", raw, flags=re.M)
    return json.loads(raw)


def profiles_list(d: dict) -> list:
    return d.setdefault("profiles", {}).setdefault("list", [])


def find_profile(d: dict, distro: str) -> dict | None:
    want = distro.lower()
    for p in profiles_list(d):
        if p.get("name", "").lower() == want:
            return p
    for p in profiles_list(d):
        cl = str(p.get("commandLine", "")).lower()
        if f"-d {want}" in cl or f"--distribution {want}" in cl:
            return p
    return None


def detect_distro_name() -> str:
    """Best guess at the distro name this is being run for."""
    if os.environ.get("WSL_DISTRO_NAME"):
        return os.environ["WSL_DISTRO_NAME"]
    return "omarchy"


def inherit_from(d: dict, name: str) -> dict:
    """Read presentation settings from an existing profile to use as defaults.

    Lets us offer 'the same look as your existing Ubuntu profile' rather than
    imposing our own opinions.
    """
    src = find_profile(d, name)
    if not src:
        return {}
    font = src.get("font") or {}
    out = {
        "font_face": font.get("face") or src.get("fontFace"),
        "font_size": font.get("size") or src.get("fontSize"),
        "opacity": src.get("opacity"),
        "acrylic": src.get("useAcrylic"),
        "padding": src.get("padding"),
        "cursor": src.get("cursorShape"),
        "scheme": src.get("colorScheme"),
        "intense": src.get("intenseTextStyle"),
    }
    return {k: v for k, v in out.items() if v is not None}


# ------------------------------------------------------------- prompting ---
def _ask(prompt: str, default):
    shown = "yes" if default is True else "no" if default is False else str(default)
    try:
        reply = input(f"  {prompt} [{_c('90', shown)}]: ").strip()
    except EOFError:
        print()
        return default
    return default if reply == "" else reply


def ask_bool(prompt: str, default: bool) -> bool:
    r = _ask(prompt + " (yes/no)", default)
    if isinstance(r, bool):
        return r
    return str(r).strip().lower().startswith("y")


def ask_int(prompt: str, default: int) -> int:
    r = _ask(prompt, default)
    try:
        return int(str(r))
    except ValueError:
        warn(f"Not a number; keeping {default}")
        return default


def ask_float(prompt: str, default: float) -> float:
    r = _ask(prompt, default)
    try:
        return float(str(r))
    except ValueError:
        warn(f"Not a number; keeping {default}")
        return default


def ask_str(prompt: str, default: str) -> str:
    return str(_ask(prompt, default))


def ask_choice(prompt: str, options: list[str], default: str) -> str:
    print()
    for i, o in enumerate(options, 1):
        marker = _c("32", " (current)") if o == default else ""
        print(f"    {_c('36', str(i) + ')')} {o}{marker}")
    r = _ask(prompt, default)
    s = str(r)
    if s.isdigit() and 1 <= int(s) <= len(options):
        return options[int(s) - 1]
    return s if s in options else default


# ------------------------------------------------------------------ icon ---
def windows_fonts() -> list[str]:
    """Font filenames installed on the Windows side (machine + per-user)."""
    names: list[str] = []
    for base in ("/mnt/c/Windows/Fonts",):
        try:
            names += [p.name for p in Path(base).iterdir()]
        except OSError:
            pass
    local = windows_env("LOCALAPPDATA")
    if local:
        d = to_wsl_path(f"{local}\\Microsoft\\Windows\\Fonts")
        if d:
            try:
                names += [p.name for p in d.iterdir()]
            except OSError:
                pass
    return names


def has_nerd_font(face: str) -> bool:
    """Is a font providing Nerd Font glyphs installed on Windows?

    Windows Terminal renders with WINDOWS fonts, so a Nerd Font inside the
    distro does nothing. Without one, Omarchy's prompt and eza icons render
    as tofu boxes.
    """
    key = face.lower().replace(" ", "").replace("nerdfont", "").replace("nf", "")
    key = key.strip() or "jetbrainsmono"
    installed = [n.lower().replace(" ", "") for n in windows_fonts()]
    for n in installed:
        if key in n and ("nerd" in n or n.endswith("nf.ttf") or "nfm" in n):
            return True
    return False


def offer_nerd_font(face: str) -> None:
    """Warn when the chosen face has no Nerd Font on Windows, and offer winget."""
    if has_nerd_font(face):
        ok(f"Nerd Font available on Windows for '{face}'")
        return

    warn(f"No Nerd Font found on Windows matching '{face}'.")
    note("Windows Terminal renders with Windows fonts, so Omarchy's prompt and")
    note("eza icons will show as boxes until one is installed.")

    pkgs = {
        "JetBrainsMono Nerd Font": "DEVCOM.JetBrainsMonoNerdFont",
        "CaskaydiaCove Nerd Font": "DEVCOM.CascadiaCodeNerdFont",
        "FiraCode Nerd Font": "DEVCOM.FiraCodeNerdFont",
    }
    print()
    note("Note: 'SourceFoundry.HackFonts' installs PLAIN Hack, which has no")
    note("Nerd Font glyphs. There is no reliable Hack Nerd Font winget package -")
    note("get it from https://www.nerdfonts.com/font-downloads if you want Hack.")
    print()
    faces = list(pkgs)
    for i, f in enumerate(faces, 1):
        print(f"    {_c('36', str(i) + ')')} {f}  {_c('90', pkgs[f])}")
    print(f"    {_c('36', '0)')} skip")

    try:
        sel = input(f"  Install one now? [{_c('90', '1')}]: ").strip() or "1"
    except EOFError:
        print()
        return
    if sel == "0":
        note("Skipped. Install later with:")
        note("  winget install --id DEVCOM.JetBrainsMonoNerdFont")
        return

    try:
        chosen = faces[int(sel) - 1]
    except (ValueError, IndexError):
        chosen = faces[0]

    note(f"Installing {chosen}...")
    try:
        subprocess.run(["winget.exe", "install", "--id", pkgs[chosen],
                        "--accept-source-agreements", "--accept-package-agreements"],
                       timeout=600, cwd="/mnt/c")
        ok(f"{chosen} installed")
        warn("Now set the profile font face to exactly:")
        print(f"      {_c('1', chosen)}")
        note("and fully restart Windows Terminal so it sees the new font.")
    except FileNotFoundError:
        bad("winget.exe not found. Download from https://www.nerdfonts.com/font-downloads")
    except subprocess.TimeoutExpired:
        warn("winget timed out; check the install manually")


def install_icon(distro: str) -> str | None:
    """Copy the project icon somewhere Windows Terminal can always read it."""
    local = windows_env("LOCALAPPDATA")

    # An icon already staged on the Windows side is the most reliable option:
    # it stays readable even when the distro is stopped.
    if local:
        staged_win = f"{local}\\omarchy-wsl2\\omarchy-wsl2.ico"
        staged = to_wsl_path(staged_win)
        if staged and staged.is_file():
            return staged_win

    src = None
    here = Path(__file__).resolve()
    candidates = [
        Path("/usr/lib/wsl/omarchy-wsl2.ico"),          # inside the distro
        here.parent.parent.parent.parent / "assets/omarchy-wsl2.ico",  # repo overlay
        Path.cwd() / "assets/omarchy-wsl2.ico",
        # Reachable when this runs from another distro (e.g. Ubuntu).
        Path(f"/mnt/wsl/{distro}/usr/lib/wsl/omarchy-wsl2.ico"),
    ]
    # Walk up from the script looking for a repo checkout.
    for parent in here.parents:
        candidates.append(parent / "assets/omarchy-wsl2.ico")

    for cand in candidates:
        try:
            if cand.is_file():
                src = cand
                break
        except OSError:
            continue

    if src and local:
        dest_dir_win = f"{local}\\omarchy-wsl2"
        dest_dir = to_wsl_path(dest_dir_win)
        if dest_dir:
            try:
                dest_dir.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest_dir / "omarchy-wsl2.ico")
                return f"{dest_dir_win}\\omarchy-wsl2.ico"
            except OSError:
                pass

    # Fall back to the UNC path into the distro (needs the distro running).
    if src and str(src).startswith("/usr/lib/wsl"):
        return f"\\\\wsl.localhost\\{distro}\\usr\\lib\\wsl\\omarchy-wsl2.ico"
    return None


# ------------------------------------------------------------------ main ---
def main() -> int:
    ap = argparse.ArgumentParser(
        prog="omarchy-wsl-wt",
        description="Configure the Windows Terminal profile for Omarchy.")
    ap.add_argument("--distro", default=detect_distro_name(),
                    help="WSL distro / profile name (default: %(default)s)")
    ap.add_argument("--from-profile", default=None, metavar="NAME",
                    help="Inherit look-and-feel defaults from an existing "
                         "profile, e.g. --from-profile Ubuntu")
    ap.add_argument("-i", "--interactive", action="store_true",
                    help="Prompt for each setting (defaults come from "
                         "--from-profile when given)")
    ap.add_argument("--theme", default=None,
                    help="Omarchy theme to match (default: the distro's active theme)")
    ap.add_argument("--opacity", type=int, default=None,
                    help="Background opacity 0-100 (default: 90, or inherited)")
    ap.add_argument("--no-acrylic", action="store_true",
                    help="Disable the acrylic blur effect")
    ap.add_argument("--font", default=None,
                    help="Font face (default: JetBrainsMono Nerd Font, or inherited)")
    ap.add_argument("--font-size", type=float, default=None)
    ap.add_argument("--padding", default=None)
    ap.add_argument("--set-default", action="store_true",
                    help="Make this the default Windows Terminal profile")
    ap.add_argument("--detect", action="store_true",
                    help="Report what was found and exit without changing anything")
    ap.add_argument("--restore", action="store_true",
                    help="Restore the most recent backup")
    ap.add_argument("--list-themes", action="store_true")
    ap.add_argument("--list-profiles", action="store_true",
                    help="List the Windows Terminal profiles found")
    args = ap.parse_args()

    if args.list_themes:
        head("Available matched schemes")
        for k, v in SCHEMES.items():
            print(f"  {k:<14} {v['name']}")
        return 0

    if args.list_profiles:
        s = find_settings()
        if not s:
            bad("Windows Terminal settings.json not found.")
            return 1
        try:
            for p in profiles_list(load_settings(s)):
                if not p.get("hidden"):
                    print(p.get("name", "?"))
        except json.JSONDecodeError as e:
            bad(f"Could not parse settings.json: {e}")
            return 1
        return 0

    head("Windows Terminal")
    settings = find_settings()
    if not settings:
        bad("Windows Terminal settings.json not found.")
        note("Is Windows Terminal installed?  winget install Microsoft.WindowsTerminal")
        return 1
    ok(f"settings.json: {settings}")

    if args.restore:
        backups = sorted(settings.parent.glob("settings.json.omarchy-bak.*"))
        if not backups:
            bad("No backup found.")
            return 1
        shutil.copy2(backups[-1], settings)
        ok(f"Restored {backups[-1].name}")
        return 0

    try:
        data = load_settings(settings)
    except json.JSONDecodeError as e:
        bad(f"Could not parse settings.json: {e}")
        return 1

    prof = find_profile(data, args.distro)
    if prof:
        ok(f"Found profile: {prof.get('name')}")
    else:
        warn(f"No profile named '{args.distro}' yet.")
        note("WSL creates it on first launch. Start the distro once, then re-run.")
        if args.detect:
            return 1

    # --- work out the defaults: our opinion, optionally overlaid with the
    #     look of an existing profile the user already likes ---
    OURS = {"font_face": "JetBrainsMono Nerd Font", "font_size": 11.0,
            "opacity": 90, "acrylic": True, "padding": "10",
            "cursor": "filledBox", "intense": "all"}
    defaults = dict(OURS)

    if args.from_profile:
        inherited = inherit_from(data, args.from_profile)
        if inherited:
            ok(f"Inheriting look from profile '{args.from_profile}'")
            for k, v in inherited.items():
                if k != "scheme":
                    note(f"  {k} = {v}")
            defaults.update({k: v for k, v in inherited.items() if k != "scheme"})
        else:
            warn(f"No profile named '{args.from_profile}' to inherit from")

    # Explicit flags always win over inherited/our defaults.
    if args.font is not None:      defaults["font_face"] = args.font
    if args.font_size is not None: defaults["font_size"] = args.font_size
    if args.opacity is not None:   defaults["opacity"] = args.opacity
    if args.padding is not None:   defaults["padding"] = args.padding
    if args.no_acrylic:            defaults["acrylic"] = False

    # Resolve the theme: explicit flag, else the distro's active theme.
    theme = args.theme
    if not theme:
        for p in (Path.home() / ".config/omarchy/current/theme.name",
                  Path("/home") / args.distro / ".config/omarchy/current/theme.name"):
            try:
                if p.is_file():
                    theme = p.read_text().strip()
                    break
            except OSError:
                pass
    theme_slug = slug(theme) if theme else DEFAULT_THEME
    if theme_slug not in SCHEMES:
        warn(f"No matched scheme for '{theme_slug}'; using {DEFAULT_THEME}")
        theme_slug = DEFAULT_THEME

    set_default = args.set_default

    # --- interactive: confirm or change each setting ---
    if args.interactive:
        head("Configure the Windows Terminal profile")
        note("Press Enter to accept each default, or type a new value.")
        print()

        theme_slug = ask_choice("Colour scheme", list(SCHEMES), theme_slug)
        defaults["font_face"] = ask_str("Font face", defaults["font_face"])
        defaults["font_size"] = ask_float("Font size", float(defaults["font_size"]))
        defaults["opacity"] = ask_int("Background opacity (0-100)", int(defaults["opacity"]))
        defaults["acrylic"] = ask_bool("Use acrylic blur", bool(defaults["acrylic"]))
        defaults["padding"] = ask_str("Padding", defaults["padding"])
        defaults["cursor"] = ask_choice(
            "Cursor shape",
            ["filledBox", "bar", "underscore", "emptyBox", "vintage"],
            str(defaults["cursor"]))
        set_default = ask_bool("Make this the default Windows Terminal profile",
                               set_default)

    scheme = SCHEMES[theme_slug]
    ok(f"Theme: {theme_slug} -> scheme '{scheme['name']}'")

    icon = install_icon(args.distro)
    if icon:
        ok(f"Icon: {icon}")
    else:
        warn("Icon not found; leaving the profile icon unchanged")

    if args.detect:
        head("Detection only - nothing was changed")
        note(f"Would set: scheme='{scheme['name']}' opacity={defaults['opacity']} "
             f"acrylic={defaults['acrylic']} font='{defaults['font_face']}' "
             f"size={defaults['font_size']} padding={defaults['padding']}")
        return 0

    if not prof:
        return 1

    # --- back up before touching anything ---
    backup = settings.with_suffix(f".json.omarchy-bak.{int(time.time())}")
    shutil.copy2(settings, backup)
    ok(f"Backed up to {backup.name}")

    # --- upsert the colour scheme ---
    schemes = data.setdefault("schemes", [])
    schemes[:] = [s for s in schemes if s.get("name") != scheme["name"]]
    schemes.append(scheme)

    # --- apply the profile settings ---
    prof.update({
        "colorScheme": scheme["name"],
        "font": {"face": defaults["font_face"], "size": defaults["font_size"]},
        "opacity": defaults["opacity"],
        "useAcrylic": bool(defaults["acrylic"]),
        "padding": defaults["padding"],
        "cursorShape": defaults["cursor"],
        "intenseTextStyle": defaults.get("intense", "all"),
        "antialiasingMode": "grayscale",
        "snapOnInput": True,
    })
    if icon:
        prof["icon"] = icon
    # Leave startingDirectory unset so the shell's own default (the Linux
    # home directory) is used rather than a Windows path.
    prof.pop("startingDirectory", None)

    if set_default and prof.get("guid"):
        data["defaultProfile"] = prof["guid"]
        ok(f"Set as the default profile ({prof['guid']})")

    settings.write_text(json.dumps(data, indent=4, ensure_ascii=False) + "\n",
                        encoding="utf-8")

    head("Applied")
    ok(f"Profile '{prof.get('name')}' updated")
    note(f"scheme={scheme['name']}  opacity={defaults['opacity']}  "
         f"acrylic={defaults['acrylic']}  font={defaults['font_face']} "
         f"{defaults['font_size']}pt")
    print()
    note("Windows Terminal picks up changes immediately - open a new tab to see it.")
    offer_nerd_font(str(defaults["font_face"]))
    print()
    note("Undo with: omarchy-wsl-wt --restore")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
