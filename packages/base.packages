# base.packages - Tier 1: headless CLI/TUI core.
#
# Everything here is available for BOTH x86_64 (Arch) and aarch64 (Arch Linux
# ARM). This tier alone gives you a complete Omarchy terminal experience.
#
# Lines starting with '#' and blank lines are ignored.

# --- toolchain / package management ---
base-devel
git
sudo
which
pacman-contrib
expac
fakeroot

# --- shell & prompt ---
bash-completion
starship
zoxide
tmux

# --- editors ---
neovim

# --- modern CLI replacements (the Omarchy staples) ---
bat
eza
fd
ripgrep
fzf
jq
less
tree
tldr
man-db
dua-cli

# --- TUI apps ---
btop
lazygit
fastfetch
gum

# --- network / transfer ---
curl
wget
rsync
openssh
inetutils
whois

# --- archives ---
unzip
zip

# --- language runtimes commonly needed by dev tooling ---
python
nodejs
npm

# --- clipboard bridge (works with WSLg, used by nvim/tmux) ---
wl-clipboard

# --- session bus (notifications, portals, keyring) ---
dbus

# --- misc ---
plocate
socat
imagemagick

# --- credentials ---
# A Secret Service provider, so GitHub Copilot CLI, gh and git store tokens
# properly instead of offering to write them to a plaintext config file.
# In base rather than apps: those are all terminal tools, needed headless.
gnome-keyring
libsecret

# pkill/pgrep. Part of Arch's mandatory 'base' group, but listed explicitly
# because omarchy-wsl-keyring and omarchy-wsl-bg both depend on it.
procps-ng

# --- terminfo ---
# Without a terminfo entry for $TERM, bash's readline switches itself off and
# arrow keys print ^[[A instead of editing the line. kitty and foot ship their
# entries in separate packages; alacritty's lives in the main one.
ncurses
foot-terminfo
kitty-terminfo
