# apps.packages - Tier 2: graphical apps launched individually through WSLg.
#
# These are ordinary GTK/Qt/Wayland clients. Under WSL2 they connect to the
# WSLg compositor and appear as normal Windows windows - no Hyprland required.
#
# Enable with: make build PROFILE=apps  (or PROFILE=desktop)

# --- portals & desktop integration (makes file pickers / xdg-open work) ---
xdg-desktop-portal-gtk
xdg-utils
xdg-user-dirs
gvfs

# --- fonts (Omarchy leans heavily on Nerd Font glyphs) ---
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
ttf-jetbrains-mono-nerd
woff2-font-awesome

# --- themes / icons ---
gnome-themes-extra
adwaita-icon-theme
# Cursors ship separately from the icon theme since GNOME 50. Without them
# the pointer disappears over Wayland windows, which draw their own cursor.
adwaita-cursors

# --- terminal emulator (Omarchy's default) ---
foot

# --- browser ---
chromium

# --- file manager & viewers ---
nautilus
nautilus-python
sushi
imv
mpv
evince

# --- Omarchy's productivity apps (all verified available on aarch64) ---
libreoffice-fresh
signal-desktop
xournalpp
gnome-calculator
satty

# --- alternative terminal ---
alacritty

# --- audio control ---
playerctl
wiremix
alsa-utils

# --- filesystem access for the file manager ---
gvfs-mtp
gvfs-smb

# --- media helpers ---
ffmpegthumbnailer
yt-dlp
